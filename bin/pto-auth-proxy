#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
SELF_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
PROJECT_DIR=$(cd -- "$SELF_DIR/.." && pwd)

if [[ "${PROJECT_DIR##*/}" == app ]]; then
    TOOL_DIR=$(cd -- "$PROJECT_DIR/.." && pwd)
    COMPONENT_DIR=$PROJECT_DIR/auth-proxy
    DEFAULT_CONFIG=$TOOL_DIR/config/auth-proxy.env
    DEFAULT_WHITELIST=$TOOL_DIR/config/whitelist.txt
    DATA_DIR=$TOOL_DIR/state
    LOG_DIR=$TOOL_DIR/logs
else
    TOOL_DIR=$PROJECT_DIR
    COMPONENT_DIR=$PROJECT_DIR
    DEFAULT_CONFIG=$PROJECT_DIR/config/auth-proxy.env.example
    DEFAULT_WHITELIST=$PROJECT_DIR/config/whitelist.txt
    DATA_DIR=$PROJECT_DIR/runtime/state
    LOG_DIR=$PROJECT_DIR/runtime/logs
fi

CONFIG=${PTO_AUTH_PROXY_CONFIG:-$DEFAULT_CONFIG}
if [[ "${1:-}" == --config ]]; then
    (($# >= 2)) || { echo "--config 缺少路径" >&2; exit 2; }
    CONFIG=$2
    shift 2
fi

usage() {
    cat <<'EOF'
用法: pto-auth-proxy [--config FILE] COMMAND [ARGS]

命令:
  validate                  只读校验配置
  run                       前台运行代理（供 systemd 使用）
  traffic [MINUTES] [--json] 查看近期流量排行
  report DATE               生成 today/yesterday/YYYY-MM-DD 报告
  join                      交互式安装并启动当前用户 authd
  status                    一行检查组、authd、凭据、20809 和直连隔离
  test                      交互式端到端测试（含 GitHub 内容读取）
EOF
}

valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535))
}

valid_seconds() {
    python3 - "$1" <<'PY'
import sys
try:
    value = float(sys.argv[1])
except ValueError:
    raise SystemExit(1)
raise SystemExit(0 if 0.1 <= value <= 300 else 1)
PY
}

load_config() {
    [[ -r "$CONFIG" ]] || {
        echo "无法读取 Auth Proxy 配置: $CONFIG" >&2
        return 1
    }
    set -a
    # 配置文件由管理员控制，只允许非敏感变量赋值。
    # shellcheck source=/dev/null
    source "$CONFIG"
    set +a

    : "${PTO_AUTH_PROXY_OWNER:=pypto}"
    : "${PTO_AUTH_PROXY_GROUP:=proxyusers}"
    : "${PTO_AUTH_PROXY_PAM_SERVICE:=sshd}"
    : "${PTO_AUTH_PROXY_LISTEN_HOST:=127.0.0.1}"
    : "${PTO_AUTH_PROXY_SOCKS_PORT:=20808}"
    : "${PTO_AUTH_PROXY_HTTP_PORT:=20809}"
    : "${PTO_AUTH_PROXY_UPSTREAM_HOST:=127.0.0.1}"
    : "${PTO_AUTH_PROXY_UPSTREAM_PORT:=4780}"
    : "${PTO_AUTH_PROXY_GUARD_PORTS:=${PTO_AUTH_PROXY_UPSTREAM_PORT},4781}"
    : "${PTO_AUTH_PROXY_CLIENT_HANDSHAKE_TIMEOUT:=15}"
    : "${PTO_AUTH_PROXY_UPSTREAM_CONNECT_TIMEOUT:=5}"
    : "${PTO_AUTH_PROXY_UPSTREAM_HANDSHAKE_TIMEOUT:=10}"
    : "${PTO_AUTH_PROXY_RELAY_HALF_CLOSE_TIMEOUT:=30}"
    : "${PTO_AUTH_PROXY_CLOSE_TIMEOUT:=2}"

    export AUTHPROXY_DIR=${AUTHPROXY_DIR:-$DATA_DIR}
    export PTO_AUTH_PROXY_WHITELIST=${PTO_AUTH_PROXY_WHITELIST:-$DEFAULT_WHITELIST}
    export PTO_AUTH_PROXY_STATS_FILE=${PTO_AUTH_PROXY_STATS_FILE:-$DATA_DIR/stats.jsonl}
    export PTO_AUTH_PROXY_ALERTS_FILE=${PTO_AUTH_PROXY_ALERTS_FILE:-$DATA_DIR/alerts.jsonl}
    export PTO_AUTH_PROXY_REPORTS_DIR=${PTO_AUTH_PROXY_REPORTS_DIR:-$DATA_DIR/reports}
    export PTO_AUTH_PROXY_LOG_FILE=${PTO_AUTH_PROXY_LOG_FILE:-$LOG_DIR/auth_proxy.log}
}

validate_runtime_user() {
    local current_user required_user
    current_user=$(id -un)
    required_user=${PTO_AUTH_PROXY_OWNER:-pypto}

    if [[ "$current_user" != "$required_user" ]]; then
        echo "错误: Auth Proxy 主进程必须以用户 $required_user 运行，当前用户为 $current_user" >&2
        echo "请通过 systemd 启动，或使用: sudo -u $required_user pto-auth-proxy run" >&2
        return 1
    fi
}

validate() {
    load_config
    validate_runtime_user
    [[ "$PTO_AUTH_PROXY_LISTEN_HOST" == 127.0.0.1 ||
       "$PTO_AUTH_PROXY_LISTEN_HOST" == ::1 ]] || {
        echo "拒绝非本机监听地址: $PTO_AUTH_PROXY_LISTEN_HOST" >&2
        return 1
    }
    valid_port "$PTO_AUTH_PROXY_SOCKS_PORT" || {
        echo "SOCKS5 端口无效: $PTO_AUTH_PROXY_SOCKS_PORT" >&2; return 1;
    }
    valid_port "$PTO_AUTH_PROXY_HTTP_PORT" || {
        echo "HTTP CONNECT 端口无效: $PTO_AUTH_PROXY_HTTP_PORT" >&2; return 1;
    }
    valid_port "$PTO_AUTH_PROXY_UPSTREAM_PORT" || {
        echo "上游端口无效: $PTO_AUTH_PROXY_UPSTREAM_PORT" >&2; return 1;
    }
    local guard_port
    IFS=, read -r -a guard_ports <<< "$PTO_AUTH_PROXY_GUARD_PORTS"
    ((${#guard_ports[@]} > 0)) || {
        echo "出口守卫端口不能为空" >&2; return 1;
    }
    for guard_port in "${guard_ports[@]}"; do
        valid_port "$guard_port" || {
            echo "出口守卫端口无效: $guard_port" >&2; return 1;
        }
    done
    local timeout_name
    for timeout_name in PTO_AUTH_PROXY_CLIENT_HANDSHAKE_TIMEOUT \
                        PTO_AUTH_PROXY_UPSTREAM_CONNECT_TIMEOUT \
                        PTO_AUTH_PROXY_UPSTREAM_HANDSHAKE_TIMEOUT \
                        PTO_AUTH_PROXY_RELAY_HALF_CLOSE_TIMEOUT \
                        PTO_AUTH_PROXY_CLOSE_TIMEOUT; do
        valid_seconds "${!timeout_name}" || {
            echo "$timeout_name 必须是 0.1 到 300 秒" >&2
            return 1
        }
    done
    [[ "$PTO_AUTH_PROXY_SOCKS_PORT" != "$PTO_AUTH_PROXY_HTTP_PORT" ]] || {
        echo "SOCKS5 和 HTTP CONNECT 不能使用同一端口" >&2; return 1;
    }
    [[ -r "$COMPONENT_DIR/auth_proxy.py" ]] || {
        echo "缺少代理程序: $COMPONENT_DIR/auth_proxy.py" >&2; return 1;
    }
    [[ -r "$PTO_AUTH_PROXY_WHITELIST" ]] || {
        echo "无法读取白名单: $PTO_AUTH_PROXY_WHITELIST" >&2; return 1;
    }
    echo "Auth Proxy 配置有效"
}

COMMAND=${1:-}
[[ -n "$COMMAND" ]] || { usage; exit 2; }
shift

case "$COMMAND" in
    validate)
        (($# == 0)) || { usage; exit 2; }
        validate
        ;;
    run)
        (($# == 0)) || { usage; exit 2; }
        validate >/dev/null
        install -d -m 0750 "$DATA_DIR" "$DATA_DIR/reports" "$LOG_DIR"
        exec python3 "$COMPONENT_DIR/auth_proxy.py"
        ;;
    traffic)
        load_config
        exec python3 "$COMPONENT_DIR/auth_proxy.py" --traffic "$@"
        ;;
    report)
        (($# == 1)) || { usage; exit 2; }
        load_config
        exec python3 "$COMPONENT_DIR/auth_proxy.py" --report "$1"
        ;;
    join)
        (($# == 0)) || { usage; exit 2; }
        load_config
        export PTO_AUTH_PROXY_SOURCE_DIR=$COMPONENT_DIR
        exec bash "$COMPONENT_DIR/join-proxy.sh"
        ;;
    status)
        (($# == 0)) || { usage; exit 2; }
        load_config
        exec python3 "$COMPONENT_DIR/status_proxy.py"
        ;;
    test)
        (($# == 0)) || { usage; exit 2; }
        load_config
        exec bash "$COMPONENT_DIR/test_proxy.sh"
        ;;
    -h|--help|help) usage ;;
    *) usage; echo "未知 Auth Proxy 命令: $COMMAND" >&2; exit 2 ;;
esac
