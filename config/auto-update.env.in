# Local, root-owned adapter configuration for the reusable repo_auto_update
# module. Preserve this file across application updates.
REPO_AUTO_UPDATE_NAME=pto-auth-proxy
REPO_AUTO_UPDATE_REPOSITORY=https://github.com/pypto-tools/pto-auth-proxy.git
REPO_AUTO_UPDATE_BRANCH=main
REPO_AUTO_UPDATE_MANIFEST=update/rollout.json
REPO_AUTO_UPDATE_STATE_DIR=@TOOL_DIR@/update
REPO_AUTO_UPDATE_TMP_DIR=@TOOL_DIR@/tmp
REPO_AUTO_UPDATE_TEST_USER=@PROXY_USER@
# Fetch as the proxy owner so the egress guard permits the local SOCKS hop.
# This contains no credential: 4780 is the owner-only tunnel landing.
REPO_AUTO_UPDATE_FETCH_USER=@PROXY_USER@
REPO_AUTO_UPDATE_FETCH_ALL_PROXY=socks5h://127.0.0.1:4780
REPO_AUTO_UPDATE_VERIFY=@PREFIX@/bin/pto-auth-proxy-update-verify
REPO_AUTO_UPDATE_APPLY=@PREFIX@/bin/pto-auth-proxy-update-apply
REPO_AUTO_UPDATE_LOCK_FILE=/run/lock/pto-auth-proxy-auto-update.lock
