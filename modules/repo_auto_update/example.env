REPO_AUTO_UPDATE_NAME=example-tool
REPO_AUTO_UPDATE_REPOSITORY=https://github.com/example/example-tool.git
REPO_AUTO_UPDATE_BRANCH=main
REPO_AUTO_UPDATE_MANIFEST=update/rollout.json
REPO_AUTO_UPDATE_STATE_DIR=/opt/example-tool/update
REPO_AUTO_UPDATE_TMP_DIR=/opt/example-tool/tmp
REPO_AUTO_UPDATE_TEST_USER=example-tool
# Optional. Defaults to root with the service's normal network environment.
REPO_AUTO_UPDATE_FETCH_USER=example-tool
REPO_AUTO_UPDATE_FETCH_ALL_PROXY=socks5h://127.0.0.1:1080
REPO_AUTO_UPDATE_VERIFY=/opt/example-tool/app/bin/example-update-verify
REPO_AUTO_UPDATE_APPLY=/opt/example-tool/app/bin/example-update-apply
REPO_AUTO_UPDATE_LOCK_FILE=/run/lock/example-tool-auto-update.lock
